# ============================================================
# Dockerfile.api — FastAPI service
# Base: python:3.11-slim (no CV deps needed)
# ============================================================
FROM python:3.11-slim

# Install curl for healthcheck; no other system deps needed
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# --- Copy dependency files first (better layer caching) ---
COPY requirements.txt requirements-dev.txt ./

# --- Install all dependencies including test deps ---
RUN pip install --no-cache-dir \
    fastapi==0.111.0 \
    uvicorn[standard]==0.29.0 \
    pydantic==2.7.1 \
    pydantic-settings==2.2.1 \
    "sqlalchemy[asyncio]==2.0.30" \
    aiosqlite==0.20.0 \
    alembic==1.13.1 \
    orjson==3.10.3 \
    python-ulid==2.7.0 \
    structlog==24.1.0 \
    python-json-logger==2.0.7 \
    httpx==0.27.0 \
    python-dotenv==1.0.1 \
    click==8.1.7 \
    rich==13.7.1 \
    shapely==2.0.4 \
    # --- test deps ---
    pytest==8.2.0 \
    pytest-asyncio==0.23.7 \
    pytest-cov==5.0.0 \
    factory-boy==3.3.0 \
    Faker==25.0.0

# --- Copy application source ---
COPY app/ ./app/
COPY dashboard/ ./dashboard/
COPY tests/ ./tests/

# --- Runtime env ---
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# DB volume will be mounted at /app/db at runtime
RUN mkdir -p /app/db /app/data

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]